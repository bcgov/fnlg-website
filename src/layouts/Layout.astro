---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/main.css';
import shareImage from '@images/fnlg-cover-704x479@2x.jpg';

let { title, desc, frontmatter } = Astro.props;
let seoTitle = title;
const isProd = import.meta.env.PROD;

// Update props for markdown pages
frontmatter && (
    title = frontmatter.pageTitle,
    desc = frontmatter.description
)
---

<!doctype html>
<html lang="en-CA">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<title>{seoTitle}</title>
		<meta name="description" content={desc}>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={desc} />
		<meta property="og:url" content="https://fnlg.gov.bc.ca" />
		<meta property="og:site_name" content={seoTitle} />
		<meta property="og:image" content={shareImage.src} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:secure_url" content={shareImage.src} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seoTitle} />
		<meta name="twitter:description" content={desc} />
		<meta name="twitter:image" content={shareImage.src} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{isProd && (<script type="text/javascript">
			; (function (p, l, o, w, i, n, g) {
				if (!p[i]) {
					p.GlobalSnowplowNamespace = p.GlobalSnowplowNamespace || [];
					p.GlobalSnowplowNamespace.push(i); p[i] = function () {
						(p[i].q = p[i].q || []).push(arguments)
					}; p[i].q = p[i].q || []; n = l.createElement(o); g = l.getElementsByTagName(o)[0]; n.async = 1;
					n.src = w; g.parentNode.insertBefore(n, g)
				}
			}(window, document, "script", "https://www2.gov.bc.ca/StaticWebResources/static/sp/sp-2-14-0.js", "snowplow"));
			var collector = 'spt.apps.gov.bc.ca';
			window.snowplow('newTracker', 'rt', collector, {
				appId: "Snowplow_standalone",
				cookieLifetime: 86400 * 548,
				platform: 'web',
				post: true,
				forceSecureTracker: true,
				contexts: {
					webPage: true,
					performanceTiming: true
				}
			});
			window.snowplow('enableActivityTracking', 30, 30); // Ping every 30 seconds after 30 seconds
			window.snowplow('enableLinkClickTracking');
			window.snowplow('trackPageView');
		</script>)}
		</head>
	<body>
		<Header />
		<main class="main" id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>